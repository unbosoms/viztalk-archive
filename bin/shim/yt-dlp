#!/usr/bin/env bash
# yt-dlp の薄いラッパー。X スペースの ID が 14 文字の回 (2026-11 の第150回 1JQPpZErAagylm が最初) を扱うため、
# TwitterSpacesIE の URL 正規表現 ({13} 固定、2026-11-16 時点で upstream も同じ) を {13,14} に広げてから本体を呼ぶ。
# weekly_pipeline.sh が PATH の先頭にこのフォルダを入れる。upstream が直ったらこのフォルダごと消してよい。
PY="${YTDLP_PYTHON:-/opt/homebrew/opt/yt-dlp/libexec/bin/python}"
exec "$PY" -c '
import sys, yt_dlp
from yt_dlp.extractor.twitter import TwitterSpacesIE as S
S._VALID_URL = S._VALID_URL.replace("{13}", "{13,14}")
sys.argv[0] = "yt-dlp"
yt_dlp.main()' "$@"
